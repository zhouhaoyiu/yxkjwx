<!--miniprogram/custom-tab-bar/index.wxml-->
<view class="tab-bar">
  <view class="tab-bar-border"></view>
  <view wx:for="{{list}}" wx:key="index" class="tab-bar-item" data-path="{{item.pagePath}}" data-index="{{index}}" bindtap="switchTab">
    <!-- {{item.iconName}}
    <image> -->
    <image src="{{selected === index ? item.activeName :item.iconName}}" class="icon-image" />
    <!-- </image> -->
    <view class="icon-text" style="color: {{selected === index ? selectedColor : color}}">{{item.text}}</view>
  </view>
</view>