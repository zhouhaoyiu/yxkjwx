<!-- {{tabBarIndex}} -->
<t-tabs sticky theme="card" defaultValue="{{tabBarIndex}}" t-class="custom-tabs" bind:change="changeTabBar">
    <t-tab-panel label="我发起的" value="0">
        <scroll-view class="page" scroll-y="true">
            <view wx:for="{{sendInfo}}" wx:key="index">
                <view style="font-size: 36rpx;padding-left: 12rpx;font-weight: bold;line-height: 36rpx;padding-bottom: 10rpx;">
                    {{item.workDate}}
                </view>
                <view class="list">
                    <!-- 根据status来设置对应颜色 status为0是白色 1是rgba(119, 255, 130, 0.15) 2是red -->
                    <view bindtap="goDetails" wx:for="{{item.workInfo}}" wx:key="index" class="list-item" style="background-color:{{item.status==0?'white':item.status==1?'rgba(119, 255, 130, 0.15)':' rgba(255, 100, 100, 0.10);'}}" data-workuuid="{{item.workUuid}}">
                        <view class="list-item-title">有限空间作业审批 {{index+1}}</view>
                        <view class="list-item-info">
                            <view>
                                作业时间：{{item.workDate}}
                            </view>
                        </view>
                        <!-- <view class="list-item-time">{{item.time}}</view> -->
                    </view>
                </view>
            </view>
        </scroll-view>
    </t-tab-panel>
    <t-tab-panel label="我审批的" value="1">
        <scroll-view class="page" scroll-y="true">
            <view wx:for="{{verifyInfo}}" wx:key="index">
                <view style="font-size: 36rpx;padding-left: 12rpx;font-weight: bold;line-height: 36rpx;padding-bottom: 10rpx;">
                    {{item.workDate}}
                </view>

                <view class="list" wx:if="{{item.workInfo.length}}">
                    <!-- 根据status来设置对应颜色 status为0是白色 1是rgba(119, 255, 130, 0.15) 2是red -->
                    <view bindtap="goDetails" wx:for="{{item.workInfo}}" wx:key="index" class="list-item" style="background-color:{{item.status==0?'white':item.status==1?'rgba(119, 255, 130, 0.15)':' rgba(255, 100, 100, 0.10);'}}" data-workuuid="{{item.workUuid}}">
                        <view class="list-item-title">有限空间作业审批 {{index+1}}</view>
                        <view class="list-item-info">
                            <view>
                                作业时间：{{item.workDate}}
                            </view>
                        </view>
                    </view>
                </view>
                <view wx:else>
                    暂无内容
                </view>
            </view>
        </scroll-view>
    </t-tab-panel>
</t-tabs>
<t-toast id="toast" />