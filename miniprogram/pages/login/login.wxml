<view class="page">
    <image class="logo" src="../../image/tygs.jpg" mode="aspectFit" />
    <text class="eyebrow">太原供水</text>
    <view class="heading">有限空间作业</view>
    <view class="loginBox">
        <t-input value="{{username}}" label="账号" data-inputfield="username" onchange="setInputData" placeholder="工作账号" />
        <t-input value="{{password}}" label="密码" type="password" data-inputfield="password" onchange="setInputData" placeholder="密码" />
        <view class="error" wx:if="{{error}}">{{error}}</view>
        <t-button bindtap="wxLogin" theme="primary" block disabled="{{submitting}}" loading="{{submitting}}">登录</t-button>
    </view>
</view>
